pipeline {
    agent {
        label 'docker' // Runs execution on your dedicated EC2 Docker agent instance
    }
    
    environment {
        // Change 'mgsanthoshkumar' if your Docker Hub username is different
        DOCKER_IMAGE = "mgsanthoshkumar/python-todo-app:${BUILD_NUMBER}"
        CREDENTIALS_ID = "docker-cred"
    }
    
    stages {
        stage('Checkout Code') {
            steps {
                // Automatically checks out your forked repo via Jenkins SCM
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Navigates to the Python app directory inside your repo
                    dir('python-jenkins-argocd-k8s') {
                        sh "docker build -t ${DOCKER_IMAGE} ."
                    }
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${CREDENTIALS_ID}") {
                        def customImage = docker.image("${DOCKER_IMAGE}")
                        customImage.push()
                    }
                }
            }
        }
        
        stage('Update K8S Manifest & Push to GitHub') {
            steps {
                script {
                    // Uses your GitHub token credential to push the manifest update back
                    withCredentials([string(credentialsId: 'github-token-cred', variable: 'GITHUB_TOKEN')]) {
                        sh '''
                            git config user.email "jenkins@ci.local"
                            git config user.name "Jenkins CI"
                            
                            # Navigate to the deployment manifest folder
                            cd python-jenkins-argocd-k8s/deploy
                            
                            # Update the image tag in your deployment file dynamically
                            sed -i "s|image:.*|image: mgsanthoshkumar/python-todo-app:${BUILD_NUMBER}|g" deployment.yaml
                            
                            git add deployment.yaml
                            git commit -m "CI: update image tag to ${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/mgsanthoshkumar/Jenkins-Zero-To-Hero.git HEAD:main
                        '''
                    }
                }
            }
        }
    }
}
